    { "parameters": { "jsCode": "const d = $('Webhook (Orion Intake)').first().json;\nconst isVideo = /\\.(mp4|mov|webm|mkv)$/i.test(d.file_path || '');\nconst link = (d.link_aff || '').trim();\nconst deskripsi = (d.deskripsi || '').trim();\nconst platform = (d.platform || 'fb').toLowerCase();\nlet prompt;\nif (link) {\n  prompt = `Kamu adalah AI copywriter affiliate ZIYAN. Dari deskripsi produk berikut, buat caption promosi SINGKAT (maks 2 kalimat), casual tapi persuasive, bahasa Indonesia. FORMAT WAJIB persis:\\nBARIS 1: ${link}\\nBARIS 2: (caption dari deskripsi)\\nBARIS 3: (3-5 hashtag relevan platform ${platform}, tanpa # ganda)\\nDESKRIPSI: ${deskripsi}`;\n} else {\n  prompt = `Kamu adalah AI influencer ZIYAN. Dari teks berikut buat caption CASUAL/SANTAI (maks 2 kalimat) ala posting harian influencer, bahasa Indonesia, tanpa jualan. Sertakan 3 hashtag relevan platform ${platform}.\\nTEKS: ${deskripsi || '(tidak ada deskripsi, buat caption umum menarik)'}`;\n}\nreturn [{ json: { isVideo, link, deskripsi, platform, caption_prompt: prompt, fileName: d.file_path.split('/').pop() } }];" }, "id": "a3", "name": "Detect & Build Prompt", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [710, 300] },
    { "parameters": { "method": "POST", "url": "http://127.0.0.1:20128/v1/chat/completions", "sendHeaders": true, "headerParameters": { "parameters": [ { "name": "Content-Type", "value": "application/json" }, { "name": "Authorization", "value": "=Bearer {{ $env.HERMES_CUSTOM_9ROUTER_API_KEY }}" } ] }, "sendBody": true, "specifyBody": "json", "jsonBody": "={\"model\":\"openrouter/auto\",\"messages\":[{\"role\":\"user\",\"content\":\"{{ $json.caption_prompt }}\"}]}", "options": {} }, "id": "a4", "name": "AI Caption Agent (9router)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [940, 300] },
    { "parameters": { "conditions": { "options": { "caseSensitive": false }, "conditions": [ { "leftValue": "={{ $json.isVideo }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } } ] } }, "id": "a5", "name": "IF Video?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1170, 300] },
    { "parameters": { "method": "POST", "url": "=https://graph.facebook.com/v19.0/975723622288353/videos", "sendBody": true, "specifyBody": "json", "jsonBody": "={\"description\":\"{{ $node['AI Caption Agent (9router)'].json.choices[0].message.content }}\",\"access_token\":\"{{ $env.FB_PAGE_TOKEN }}\"}", "options": {} }, "id": "a6", "name": "FB Upload Video", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1400, 200] },
    { "parameters": { "method": "POST", "url": "=https://www.googleapis.com/youtube/v3/videos?part=snippet,status&uploadType=multipart", "sendHeaders": true, "headerParameters": { "parameters": [ { "name": "Authorization", "value": "=Bearer {{ $env.YT_ACCESS_TOKEN }}" } ] }, "sendBody": true, "specifyBody": "json", "jsonBody": "={\"snippet\":{\"title\":\"{{ $json.fileName }}\",\"description\":\"{{ $node['AI Caption Agent (9router)'].json.choices[0].message.content }}\"},\"status\":{\"privacyStatus\":\"private\"}}", "options": {} }, "id": "a7", "name": "YT Upload Shorts", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1630, 200] },
