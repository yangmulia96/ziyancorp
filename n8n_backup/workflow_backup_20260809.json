    "functionCode": "const msg = $json.message || {};\nconst text = msg.text || '';\nconst linkMatch = text.match(/https?:\\/\\/\\S+/);\nconst link = linkMatch ? linkMatch[0] : '';\nconst files = [];\nif (msg.photo) { msg.photo.forEach(p => files.push({ type: 'photo', file_id: p.file_id })); }\nif (msg.video) { files.push({ type: 'video', file_id: msg.video.file_id }); }\nif (msg.document) { files.push({ type: 'document', file_id: msg.document.file_id }); }\n// Kalau banyak file, tiap file = 1 konten (caption sama dari link)\nconst items = (files.length > 0 ? files : [{ type: 'none', file_id: null }]).map(f => ({\n  json: { link, file_type: f.type, file_id: f.file_id, caption: '', status: 'PENDING', timestamp: new Date().toISOString() }\n}));\nreturn items;"
   },
