        "specifyBody": "json",
        "jsonBody": "={\"description\":\"{{ $json.caption }}\\n\\n\ud83d\udd17 Link: {{ $json.link_affiliate }}\",\"access_token\":\"{{ $env.FB_PAGE_TOKEN }}\"}",
