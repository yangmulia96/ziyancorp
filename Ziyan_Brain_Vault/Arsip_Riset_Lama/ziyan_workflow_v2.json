    {
      "parameters": {
        "jsCode": "const r = items[0].json;\nreturn [{ json: {\n  docId: r.rowNumber || r.id,\n  link_affiliate: r.link_affiliate || '',\n  url_foto_asli: r.url_foto_asli || '',\n  kategori: r.kategori || '',\n  harga: r.harga || '',\n  diskon: r.diskon || '',\n  caption: r.caption || '',\n  is_video: (r.url_foto_asli||'').match(/\\.(mp4|mov|webm)$/i) ? true : false\n}}];"
      },
      "name": "Parse Sheet Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = items[0].json;\n// caption dari AI response\nconst aiCaption = (d.choices?.[0]?.message?.content || d.caption || '').trim();\nconst bgPrompt = `Hyper-realistic lifestyle background for a ${d.kategori} product, soft studio lighting, premium e-commerce look, no text, no watermark`;\nconst promoPrompt = `Clean minimal promo card background, ${d.kategori} theme, modern, elegant, space for product photo, no text`;\nreturn [{ json: { bg_prompt: bgPrompt, promo_prompt: promoPrompt, caption: aiCaption, link: d.link_affiliate, foto: d.url_foto_asli, kategori: d.kategori, harga: d.harga, diskon: d.diskon, docId: d.docId } }];"
      },
      "name": "Build Prompts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:20128/v1/images/generations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.HERMES_CUSTOM_9ROUTER_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"cf/@cf/black-forest-labs/flux-1-schnell\",\"prompt\":\"{{ $json.bg_prompt }}\",\"size\":\"1024x1024\",\"n\":1}",
        "options": {}
      },
      "name": "9router: Generate BG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1250,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:20128/v1/images/generations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.HERMES_CUSTOM_9ROUTER_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"cf/@cf/black-forest-labs/flux-1-schnell\",\"prompt\":\"{{ $json.promo_prompt }}\",\"size\":\"1024x1024\",\"n\":1}",
        "options": {}
      },
      "name": "9router: Generate Promo BG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1250,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "const py = require('child_process');\nconst item = items[0].json;\nconst bgUrl = (item.bg_data && (item.bg_data.data?.[0]?.url || item.bg_data.data?.[0]?.b64_json)) ? (item.bg_data.data[0].url || item.bg_data.data[0].b64_json) : (item.bg_url || '');\nconst promoUrl = (item.promo_data && (item.promo_data.data?.[0]?.url || item.promo_data.data?.[0]?.b64_json)) ? (item.promo_data.data[0].url || item.promo_data.data[0].b64_json) : (item.promo_url || '');\nconst foto = item.foto;\nconst script = `\nimport sys, json, io, base64, requests\nfrom PIL import Image\nbg_url, promo_url, foto_url = sys.argv[1], sys.argv[2], sys.argv[3]\ndef load(u):\n    if u.startswith('data:'):\n        b = base64.b64decode(u.split(',',1)[1]); return Image.open(io.BytesIO(b)).convert('RGBA')\n    r = requests.get(u, timeout=30); r.raise_for_status(); return Image.open(io.BytesIO(r.content)).convert('RGBA')\ndef composite(bg, fg, ratio):\n    bg = bg.resize((1080,1080), Image.LANCZOS)\n    w = int(1080*ratio); h = int(w*fg.height/fg.width)\n    if h>1080: h=1080; w=int(h*fg.width/fg.height)\n    fg = fg.resize((w,h), Image.LANCZOS)\n    c = bg.copy(); x=(1080-w)//2; y=(1080-h)//2\n    if fg.mode=='RGBA': c.paste(fg,(x,y),fg)\n    else: c.paste(fg,(x,y))\n    buf=io.BytesIO(); c.save(buf,format='PNG'); return base64.b64encode(buf.getvalue()).decode()\nbg=load(bg_url); promo=load(promo_url); foto=load(foto_url)\nslides=[]\nslides.append(composite(bg, foto, 0.62))\nslides.append(composite(bg, foto, 0.78))\nslides.append(composite(promo, foto, 0.5))\nprint(json.dumps({'slides':slides}))\n`;\nconst out = py.execSync('python3', [ '-c', script, bgUrl, promoUrl, foto ], { encoding: 'utf-8', maxBuffer: 1024*1024*50 });\nconst res = JSON.parse(out.trim());\nreturn [{ json: { ...item, slides: res.slides } }];"
      },
      "name": "Composite 3 Slides (PIL)",
      "type": "n8n-nodes-base.code",
