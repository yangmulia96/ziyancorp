        "command": "={{ \"python3 -c \\\"import os,sys; from requests_oauthlib import OAuth1Session; CK=os.environ['X_CK']; CS=os.environ['X_CS']; AT=os.environ['X_AT']; ATS=os.environ['X_ATS']; o=OAuth1Session(CK,client_secret=CS,resource_owner_key=AT,resource_owner_secret=ATS); r=o.post('https://api.twitter.com/2/tweets', json={'text': '''\" + $json.caption + ' ' + $json.link_affiliate + \"'''}); print(r.status_code, r.text[:100])\\\"\" }}",
