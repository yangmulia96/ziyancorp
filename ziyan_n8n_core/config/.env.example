# ==============================================================================
# Ziyan Automation Systems (ZAS) - Environment Configuration Template
# Salin file ini menjadi `.env` dan sesuaikan nilai variabel dengan instance Anda.
# ==============================================================================

# 1. n8n Instance Configuration
N8N_INSTANCE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key_here

# 2. AI Model & LLM API Keys (Corporate Corporate Credentials)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 3. WhatsApp Gateway Integration (Evolution API / WAHA / Fonnte)
WHATSAPP_GATEWAY_URL=http://localhost:8080
WHATSAPP_API_KEY=your_whatsapp_gateway_secret_key
WHATSAPP_SESSION_NAME=zas_corporate_session

# 4. Google Workspace Integrations
GOOGLE_SHEET_LEAD_DATABASE_ID=your_crm_google_sheet_id_here
GOOGLE_DRIVE_INVOICE_FOLDER_ID=your_google_drive_invoice_folder_id_here
GOOGLE_SHEET_B2B_PROSPECTS_ID=your_prospects_sheet_id_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# 5. Telegram Operations & Alert Channels
TELEGRAM_BOT_TOKEN=your_zas_alert_bot_token_here
TELEGRAM_OPS_ALERT_CHAT_ID=your_ops_telegram_chat_id_here
TELEGRAM_BROADCAST_CHANNEL_ID=your_broadcast_channel_id_here

# 6. Target Scraping & Lead Gen Settings
SCRAPER_TARGET_KEYWORD="Klinik Kecantikan Jakarta"
LINKEDIN_AUTHOR_URN=your_linkedin_author_urn_here
